{
  // NebulaNet on Cloudflare Workers (README.md, "Deploying").
  "name": "nebulanet",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Nebula's default NebulaNet address. Deploying creates the DNS record, as long as mackery.com is a zone on the same
  // Cloudflare account.
  "routes": [{ "pattern": "nebulanet.mackery.com", "custom_domain": true }],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomObject" },
      // The room list and the numbers (src/directory.ts).
      { "name": "LOBBIES", "class_name": "LobbyDirectory" }
    ]
  },
  // SQLite-backed Durable Objects work on the Workers free plan.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomObject"] },
    { "tag": "v2", "new_sqlite_classes": ["LobbyDirectory"] }
  ],
  "observability": { "enabled": true },
  // Workers Builds' branch Previews (npx wrangler preview): each gets its own Durable Object namespaces, so a branch
  // never touches production's rooms. The bindings are repeated because the code reads them from env; secrets (TURN)
  // aren't inherited, so Previews hand out STUN only.
  "previews": {
    "durable_objects": {
      "bindings": [
        { "name": "ROOMS", "class_name": "RoomObject" },
        { "name": "LOBBIES", "class_name": "LobbyDirectory" }
      ]
    }
  }
}
